{
  "name": "sweety-server",
  "version": "1.0.0",
  "description": "Backend API for Sweety - Blood Glucose Tracker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node database/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "glucose-tracker",
    "healthcare",
    "express",
    "postgresql",
    "neon"
  ],
  "author": "Kenpath Candidate",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 15000
  }
}
